<UserControl
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:av="http://schemas.microsoft.com/expression/blend/2008" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" mc:Ignorable="av" x:Class="GuessMelody.Wpf.Tabs.FoldersTabView"
             av:DesignHeight="526.72">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ===== Верхняя панель ===== -->
        <Border Grid.Row="0" Padding="8" Background="#F0F0F0"
                BorderBrush="#CCC" BorderThickness="1" Margin="0,0,0,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Row="0" Orientation="Horizontal">
                    <Button Content="📂 Выбрать папку игры…"
                    Click="PickFolder_Click" Padding="10,4" Margin="0,0,6,0"/>
                    <Button Content="🔄 Пересканировать"
                    Click="Rescan_Click" Padding="10,4" Margin="0,0,20,0"/>

                    <Button Content="💾 Сохранить"
                    Click="Save_Click" Padding="10,4" Margin="0,0,6,0"
                    ToolTip="Сохранить в текущий файл настроек"/>
                    <Button Content="💾 Сохранить как…"
                    Click="SaveAs_Click" Padding="10,4" Margin="0,0,6,0"
                    ToolTip="Сохранить в выбранный файл .json"/>
                    <Button Content="📥 Загрузить из…"
                    Click="LoadFrom_Click" Padding="10,4" Margin="0,0,20,0"
                    ToolTip="Загрузить настройки из произвольного файла .json"/>

                    <TextBlock Text="Старт по умолчанию, сек:"
                       VerticalAlignment="Center" Margin="0,0,4,0"/>
                    <TextBox x:Name="DefaultStartBox" Width="60"
                     Text="0" VerticalContentAlignment="Center"
                     LostFocus="DefaultStart_LostFocus"/>
                </StackPanel>


                
            </Grid>
        </Border>

        <!-- ===== Дерево + плеер ===== -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*"/>
                <ColumnDefinition Width="3*"/>
            </Grid.ColumnDefinitions>

            <!-- Дерево -->
            <GroupBox Grid.Column="0" Header="Категории и треки" Margin="0,0,6,0">
                <TreeView x:Name="Tree"
                          SelectedItemChanged="Tree_SelectedItemChanged"
                          MouseDoubleClick="Tree_MouseDoubleClick"/>
            </GroupBox>

            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    
                </Grid.RowDefinitions>

                <GroupBox Grid.Row="0" Header="Плеер" Padding="8">
                    <StackPanel Orientation="Horizontal">
                        <Button Content="▶" Click="Play_Click"
                                Padding="14,4" Margin="0,0,6,0"/>
                        <Button Content="⏸" Click="Pause_Click"
                                Padding="14,4" Margin="0,0,6,0"/>
                        <Button Content="⏹" Click="Stop_Click"
                                Padding="14,4" Margin="0,0,20,0"/>

                        <TextBlock Text="Громкость:" VerticalAlignment="Center"
                                   Margin="0,0,4,0"/>
                        <Slider x:Name="VolSlider" Width="140"
                                Minimum="0" Maximum="1" Value="0.8"
                                ValueChanged="VolSlider_ValueChanged"/>
                        <TextBlock x:Name="VolText" Margin="6,0,0,0"
                                   VerticalAlignment="Center" FontFamily="Consolas"/>
                        <!-- Путь к папке игры (справа) -->
                        <TextBlock x:Name="RootPathText" HorizontalAlignment="Right"
           VerticalAlignment="Center"
           Foreground="#555" TextTrimming="CharacterEllipsis"
           MaxWidth="400"/>

                    </StackPanel>
                </GroupBox>

                <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,6,0,0">
                    <ProgressBar x:Name="Progress" Width="520" Height="18"
                                 Minimum="0" Maximum="1000"/>
                    <TextBlock x:Name="TimeText" Margin="10,0,0,0"
                               VerticalAlignment="Center" FontFamily="Consolas"/>
                </StackPanel>

                <GroupBox Grid.Row="2"
                          Header="Старт превью для выбранного трека"
                          Padding="8" Margin="0,10,0,0">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Старт с, сек:" VerticalAlignment="Center"
                                   Margin="0,0,6,0"/>
                        <TextBox x:Name="TrackStartBox" Width="70"
                                 VerticalContentAlignment="Center"
                                 LostFocus="TrackStartBox_LostFocus"
                                 IsEnabled="False"/>
                        <Button Content="💾 Применить"
                                Click="ApplyTrackStart_Click"
                                Padding="10,4" Margin="10,0,6,0"
                                IsEnabled="False" x:Name="ApplyTrackBtn"/>
                        <Button Content="↺ Сбросить для трека"
                                Click="ResetTrackStart_Click"
                                Padding="10,4"
                                IsEnabled="False" x:Name="ResetTrackBtn"/>
                        <TextBlock x:Name="EffectiveStartText"
                                   Margin="20,0,0,0" VerticalAlignment="Center"
                                   Foreground="#555"/>
                    </StackPanel>
                </GroupBox>

                <GroupBox Grid.Row="3" Header="Детали"
                          Padding="8" Margin="0,10,0,0">
                    <TextBlock x:Name="InfoText" TextWrapping="Wrap"/>
                </GroupBox>
            </Grid>
        </Grid>

        <!-- ===== Лог ===== -->
        <GroupBox Grid.Row="2" Header="Лог" Margin="0,8,0,0" Height="140">
            <ListBox x:Name="LogList" FontFamily="Consolas" FontSize="12"/>
        </GroupBox>
        <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,6,0,0">
            <TextBlock Text="Файл настроек:" VerticalAlignment="Center"
                       Foreground="#555" Margin="0,0,6,0"/>
            <TextBlock x:Name="ConfigPathText" VerticalAlignment="Center"
                       Foreground="#333" FontFamily="Consolas"
                       TextTrimming="CharacterEllipsis"/>
        </StackPanel>

    </Grid>
</UserControl>
<Window x:Class="GuessMelody.Wpf.Views.HostConsoleWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Пульт ведущего"
        Height="720" Width="1100"
        WindowStartupLocation="CenterScreen">

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <!-- пресеты -->
            <RowDefinition Height="Auto"/>
            <!-- инфо о раунде -->
            <RowDefinition Height="Auto"/>
            <!-- плеер -->
            <RowDefinition Height="*"/>
            <!-- нажатия + дерево и ответ -->
            <RowDefinition Height="Auto"/>
            <!-- управление раундом -->
        </Grid.RowDefinitions>

        <!-- ============================================================ -->
        <!-- Пресеты                                                       -->
        <!-- ============================================================ -->
        <Border Grid.Row="0" Background="#ECEFF1" Padding="8"
                CornerRadius="6" Margin="0,0,0,8">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="Пресет:" VerticalAlignment="Center"
                           FontWeight="Bold" Margin="0,0,8,0"/>
                <Button Content="📥 Загрузить пресет…" Click="LoadPreset_Click"
                        Padding="10,4" Margin="0,0,6,0"/>
                <Button Content="💾 Сохранить пресет…" Click="SavePreset_Click"
                        Padding="10,4" Margin="0,0,16,0"/>

                <TextBlock Text="Файл:" VerticalAlignment="Center"
                           Foreground="#555" Margin="0,0,6,0"/>
                <TextBlock x:Name="PresetPathText" VerticalAlignment="Center"
                           FontFamily="Consolas" Foreground="#333"
                           Text="(не задан)"
                           TextTrimming="CharacterEllipsis" MaxWidth="440"/>
            </StackPanel>
        </Border>

        <!-- ============================================================ -->
        <!-- Инфо о раунде (без изменений)                                 -->
        <!-- ============================================================ -->
        <Border Grid.Row="1" Background="#263238" Padding="10"
                CornerRadius="6" Margin="0,0,0,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" Foreground="#FFD54A" FontSize="20"
                           FontWeight="Bold">
                    <Run Text="Раунд "/>
                    <Run Text="{Binding RoundNumber, Mode=OneWay}"/>
                </TextBlock>

                <StackPanel Grid.Column="1" Orientation="Horizontal"
                            Margin="20,0,0,0" VerticalAlignment="Center">
                    <TextBlock Foreground="#B0BEC5" FontSize="16">
                        <Run Text="Категория: "/>
                        <Run Text="{Binding CategoryName, Mode=OneWay}"
                             FontWeight="Bold" Foreground="White"/>
                    </TextBlock>
                    <TextBlock Foreground="#B0BEC5" FontSize="16" Margin="20,0,0,0">
                        <Run Text="Состояние: "/>
                        <Run Text="{Binding StateText, Mode=OneWay}"
                             FontWeight="Bold" Foreground="#FFD54A"/>
                    </TextBlock>
                </StackPanel>

                <TextBlock Grid.Column="2" Foreground="#90A4AE" FontSize="14"
                           Text="{Binding TrackName, Mode=OneWay}"
                           TextTrimming="CharacterEllipsis"
                           MaxWidth="280" VerticalAlignment="Center"/>
            </Grid>
        </Border>

        <!-- ============================================================ -->
        <!-- Плеер (без изменений)                                         -->
        <!-- ============================================================ -->
        <Border Grid.Row="2" Background="#F5F5F5" Padding="10"
                CornerRadius="6" Margin="0,0,0,8">
            <StackPanel>
                <StackPanel Orientation="Horizontal">
                    <Button Content="▶"  Click="Play_Click"  Padding="14,4" Margin="0,0,6,0"/>
                    <Button Content="⏸" Click="Pause_Click" Padding="14,4" Margin="0,0,6,0"/>
                    <Button Content="⏹" Click="Stop_Click"  Padding="14,4" Margin="0,0,20,0"/>
                    <Button Content="⏪ −10 c" Click="Back10_Click" Padding="10,4" Margin="0,0,4,0"/>
                    <Button Content="⏩ +10 c" Click="Fwd10_Click"  Padding="10,4" Margin="0,0,20,0"/>

                    <TextBlock Text="Громкость:" VerticalAlignment="Center" Margin="0,0,4,0"/>
                    <Slider Width="140" Value="{Binding Volume, Mode=TwoWay}"
                            Minimum="0" Maximum="1" VerticalAlignment="Center"/>

                    <TextBlock Text="{Binding TimeText, Mode=OneWay}"
                               FontFamily="Consolas" Margin="20,0,0,0"
                               VerticalAlignment="Center"/>
                </StackPanel>

                <ProgressBar Height="14" Margin="0,8,0,0"
                             Minimum="0" Maximum="1000"
                             Value="{Binding Progress, Mode=OneWay}"/>
            </StackPanel>
        </Border>

        <!-- ============================================================ -->
        <!-- Нажатия + (дерево + ответ)                                    -->
        <!-- ============================================================ -->
        <Grid Grid.Row="3" Margin="0,0,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*"/>
                <ColumnDefinition Width="3*"/>
            </Grid.ColumnDefinitions>

            <!-- Нажатия в раунде -->
            <GroupBox Grid.Column="0" Header="Нажатия в раунде" Margin="0,0,10,0">
                <DataGrid ItemsSource="{Binding Presses}"
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          CanUserAddRows="False"
                          HeadersVisibility="Column"
                          GridLinesVisibility="Horizontal"
                          AlternatingRowBackground="#FAFAFA">
                    <DataGrid.RowStyle>
                        <Style TargetType="DataGridRow">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsWinner}" Value="True">
                                    <Setter Property="Background" Value="#C8E6C9"/>
                                    <Setter Property="FontWeight" Value="Bold"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </DataGrid.RowStyle>
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="#" Binding="{Binding Order}" Width="36"/>
                        <DataGridTextColumn Header="Игрок" Binding="{Binding Name}" Width="140"/>
                        <DataGridTextColumn Header="MAC" Binding="{Binding Mac}" Width="140"/>
                        <DataGridTextColumn Header="Время" Binding="{Binding TimeText}" Width="100"/>
                    </DataGrid.Columns>
                </DataGrid>
            </GroupBox>

            <!-- Правая колонка: дерево + компактный ответ -->
            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="2*"/>
                    <!-- дерево треков -->
                    <RowDefinition Height="Auto"/>
                    <!-- ответ, компактный -->
                </Grid.RowDefinitions>

                <!-- ====== Категории и треки ====== -->
                <GroupBox Grid.Row="0" Header="Категории и треки" Margin="0,0,0,8">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,6">
                            <Button Content="▶ Прослушать трек"
                                    Click="PreviewTrack_Click"
                                    Padding="10,4" Margin="0,0,6,0"/>
                            <Button Content="⏹ Стоп превью"
                                    Click="PreviewStop_Click"
                                    Padding="10,4" Margin="0,0,16,0"/>
                            <TextBlock Text="Выбран:" VerticalAlignment="Center"
                                       Margin="0,0,6,0" Foreground="#555"/>
                            <TextBlock x:Name="SelectedTrackText"
                                       VerticalAlignment="Center"
                                       FontFamily="Consolas"
                                       TextTrimming="CharacterEllipsis"
                                       MaxWidth="380"/>
                        </StackPanel>

                        <TreeView Grid.Row="1" x:Name="PreviewTree"
                                  SelectedItemChanged="PreviewTree_SelectedItemChanged"
                                  MouseDoubleClick="PreviewTree_MouseDoubleClick"/>
                    </Grid>
                </GroupBox>

                <!-- ====== Компактный ответ ====== -->
                <Border Grid.Row="1" CornerRadius="8"
                        BorderBrush="#B0BEC5" BorderThickness="2"
                        MinHeight="90" MaxHeight="130">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Background" Value="#ECEFF1"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding AnswerActive}" Value="True">
                                    <Setter Property="Background" Value="#FFCDD2"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>

                    <Grid Margin="10">
                        <!-- Компактная сетка: имя слева, таймер справа, кнопки снизу -->
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Идёт ответ -->
                        <StackPanel Grid.Row="0" Grid.Column="0"
                                    VerticalAlignment="Center"
                                    Visibility="{Binding AnswerActive,
                                        Converter={StaticResource BoolToVisibility}}">
                            <TextBlock Text="ОТВЕЧАЕТ" FontSize="12" FontWeight="Bold"
                                       Foreground="#C62828"/>
                            <TextBlock Text="{Binding WinnerName, Mode=OneWay}"
                                       FontSize="22" FontWeight="Bold"
                                       TextTrimming="CharacterEllipsis"/>
                        </StackPanel>
                        <TextBlock Grid.Row="0" Grid.Column="1"
                                   Text="{Binding AnswerSecondsLeft, Mode=OneWay}"
                                   FontSize="44" FontWeight="Bold"
                                   Foreground="#C62828"
                                   VerticalAlignment="Center"
                                   Visibility="{Binding AnswerActive,
                                       Converter={StaticResource BoolToVisibility}}"/>

                        <!-- Простой статус, когда не идёт ответ -->
                        <TextBlock Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2"
                                   Text="Ждём нажатия кнопки…"
                                   FontSize="14" Foreground="#78909C"
                                   VerticalAlignment="Center">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Visible"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding AnswerActive}" Value="True">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>

                        <!-- Кнопки Да/Нет/Никто -->
                        <StackPanel Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2"
                                    Orientation="Horizontal"
                                    HorizontalAlignment="Center"
                                    Margin="0,6,0,0">
                            <Button Content="✅ ДА (+1)" Click="HostYes_Click"
                                    Padding="14,6" FontSize="14" Margin="0,0,6,0"
                                    Background="#66BB6A" Foreground="White"
                                    IsEnabled="{Binding AnswerActive}"/>
                            <Button Content="❌ НЕТ" Click="HostNo_Click"
                                    Padding="14,6" FontSize="14" Margin="0,0,6,0"
                                    Background="#EF5350" Foreground="White"
                                    IsEnabled="{Binding AnswerActive}"/>
                            <Button Content="🚫 Никто" Click="HostNoOne_Click"
                                    Padding="14,6" FontSize="14"
                                    Background="#78909C" Foreground="White"/>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
        </Grid>

        <!-- ============================================================ -->
        <!-- Нижняя панель (без изменений)                                 -->
        <!-- ============================================================ -->
        <Border Grid.Row="4" Background="#ECEFF1" Padding="10"
                CornerRadius="6" Margin="0,10,0,0">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="Начать раунд (категория):"
                           VerticalAlignment="Center" Margin="0,0,8,0"/>
                <Button Content="1" Click="StartCat1_Click" Padding="10,4" Margin="0,0,4,0"/>
                <Button Content="2" Click="StartCat2_Click" Padding="10,4" Margin="0,0,4,0"/>
                <Button Content="3" Click="StartCat3_Click" Padding="10,4" Margin="0,0,4,0"/>
                <Button Content="4" Click="StartCat4_Click" Padding="10,4" Margin="0,0,4,0"/>
                <Button Content="5" Click="StartCat5_Click" Padding="10,4" Margin="0,0,4,0"/>
                <Button Content="6" Click="StartCat6_Click" Padding="10,4" Margin="0,0,4,0"/>
                <Button Content="7" Click="StartCat7_Click" Padding="10,4" Margin="0,0,4,0"/>
                <Button Content="8" Click="StartCat8_Click" Padding="10,4" Margin="0,0,4,0"/>
                <Button Content="9" Click="StartCat9_Click" Padding="10,4" Margin="0,0,20,0"/>

                <Button Content="↺ Сбросить раунд" Click="ResetRound_Click"
                        Padding="10,4" Margin="0,0,6,0"/>
                <Button Content="🗑 Сбросить очки" Click="ResetScores_Click"
                        Padding="10,4"/>
                <TextBlock Margin="20,0,0,0" VerticalAlignment="Center" Foreground="#555">
                <Run Text="F1–F6 — эмуляция нажатий 6 кнопок"/>
                </TextBlock>
            </StackPanel>
        </Border>
    </Grid>
</Window>
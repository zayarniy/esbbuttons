<Window x:Class="GuessMelody.Views.PlayerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Экран игроков"
        Height="800" Width="1000"
        WindowStartupLocation="Manual"
        WindowState="Normal"
        Background="{Binding BackgroundBrush}">

    <Window.InputBindings>
        <KeyBinding Key="F11" Command="{Binding ToggleFullscreenCommand}"/>
    </Window.InputBindings>

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Заголовок -->
        <StackPanel Grid.Row="0" HorizontalAlignment="Center">
            <TextBlock Text="{Binding GameTitle}"
                       FontSize="44" FontWeight="Bold"
                       Foreground="{Binding TextBrush}"
                       HorizontalAlignment="Center"/>
            <TextBlock Text="{Binding RoundText}"
                       FontSize="26"
                       Foreground="{Binding AccentBrush}"
                       HorizontalAlignment="Center"
                       Margin="0,4,0,16"/>
        </StackPanel>

        <!-- Категории -->
        <ItemsControl Grid.Row="1" ItemsSource="{Binding Categories}" Margin="0,0,0,16">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <UniformGrid Rows="1"/>
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Border x:Name="CatBorder"
                    Margin="6" Padding="12" CornerRadius="10"
                    BorderBrush="{Binding DataContext.AccentBrush,
                                  RelativeSource={RelativeSource AncestorType=Window}}"
                    BorderThickness="2">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Background" Value="#22FFFFFF"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsActive}" Value="True">
                                        <Setter Property="Background" Value="#66FFD166"/>
                                        <Setter Property="BorderThickness" Value="3"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsBlinking}" Value="True">
                                        <Setter Property="Background" Value="#FFD166"/>
                                        <Setter Property="BorderThickness" Value="4"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <Border.RenderTransform>
                            <ScaleTransform x:Name="CatScale" ScaleX="1" ScaleY="1"/>
                        </Border.RenderTransform>
                        <Border.RenderTransformOrigin>
                            <Point X="0.5" Y="0.5"/>
                        </Border.RenderTransformOrigin>
                        <StackPanel>
                            <TextBlock Text="{Binding Name}"
                               Foreground="{Binding DataContext.TextBrush,
                                            RelativeSource={RelativeSource AncestorType=Window}}"
                               FontSize="{Binding DataContext.CategoryFontSize,
                                          RelativeSource={RelativeSource AncestorType=Window}}"
                               FontWeight="Bold"
                               TextAlignment="Center"
                               TextWrapping="Wrap"/>
                            <TextBlock Text="{Binding CountText}"
                               Foreground="{Binding DataContext.AccentBrush,
                                            RelativeSource={RelativeSource AncestorType=Window}}"
                               FontSize="{Binding DataContext.NameFontSize,
                                          RelativeSource={RelativeSource AncestorType=Window}}"
                               TextAlignment="Center"
                               Margin="0,6,0,0"/>
                        </StackPanel>
                        <Border.Triggers>
                            <EventTrigger RoutedEvent="Binding.TargetUpdated">
                                <!-- Не используется, оставлено на будущее -->
                            </EventTrigger>
                        </Border.Triggers>
                    </Border>
                    <DataTemplate.Triggers>
                        <DataTrigger Binding="{Binding IsBlinking}" Value="True">
                            <DataTrigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard RepeatBehavior="Forever">
                                        <DoubleAnimation Storyboard.TargetName="CatBorder"
                                                 Storyboard.TargetProperty="Opacity"
                                                 From="1.0" To="0.4"
                                                 Duration="0:0:0.25"
                                                 AutoReverse="True"/>
                                        <DoubleAnimation Storyboard.TargetName="CatScale"
                                                 Storyboard.TargetProperty="ScaleX"
                                                 From="1.0" To="1.05"
                                                 Duration="0:0:0.25"
                                                 AutoReverse="True"/>
                                        <DoubleAnimation Storyboard.TargetName="CatScale"
                                                 Storyboard.TargetProperty="ScaleY"
                                                 From="1.0" To="1.05"
                                                 Duration="0:0:0.25"
                                                 AutoReverse="True"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </DataTrigger.EnterActions>
                            <DataTrigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="CatBorder"
                                                 Storyboard.TargetProperty="Opacity"
                                                 To="1.0" Duration="0:0:0.1"/>
                                        <DoubleAnimation Storyboard.TargetName="CatScale"
                                                 Storyboard.TargetProperty="ScaleX"
                                                 To="1.0" Duration="0:0:0.1"/>
                                        <DoubleAnimation Storyboard.TargetName="CatScale"
                                                 Storyboard.TargetProperty="ScaleY"
                                                 To="1.0" Duration="0:0:0.1"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </DataTrigger.ExitActions>
                        </DataTrigger>
                    </DataTemplate.Triggers>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <!-- Прогресс фрагмента -->
        <StackPanel Grid.Row="2" VerticalAlignment="Top" Margin="0,0,0,12">
            <TextBlock Text="{Binding StateText}"
               FontSize="36" FontWeight="Bold"
               Foreground="{Binding AccentBrush}"
               HorizontalAlignment="Center"/>

            <!-- Прогресс фрагмента: Value идёт от 1.0 к 0.0 по мере проигрывания -->
            <ProgressBar Height="18" Margin="60,12,60,0"
                 Minimum="0" Maximum="1"
                 Value="{Binding TrackRemainFraction, Mode=OneWay}"
                 Background="#22FFFFFF"
                 Foreground="{Binding AccentBrush}"
                 BorderBrush="#44FFFFFF"
                 BorderThickness="1"/>
        </StackPanel>

        <!-- Ожидание/нажатие -->
        <TextBlock Grid.Row="3" Text="{Binding FirstPressedText, StringFormat='Нажал: {0}'}"
                   FontSize="28"
                   Foreground="{Binding TextBrush}"
                   HorizontalAlignment="Center"
                   Visibility="{Binding FirstPressedText, Converter={StaticResource NullToVisibility}, ConverterParameter=Invert}"
                   Margin="0,0,0,8"/>

        <!-- Игроки -->
        <ItemsControl Grid.Row="4" ItemsSource="{Binding Teams}">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <UniformGrid Rows="1"/>
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Border x:Name="TeamBorder"
                    Margin="6" Padding="16" CornerRadius="12"
                    Background="#22FFFFFF"
                    MouseLeftButtonDown="TeamTile_LeftClick"
                    MouseRightButtonDown="TeamTile_RightClick"
                    Tag="{Binding Name}">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsFlashing}" Value="True">
                                        <Setter Property="Background" Value="#FFD166"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>

                        <StackPanel>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">

                                <!-- Индикатор heartbeat -->
                                <TextBlock x:Name="HbDot"
           Text="{Binding AliveGlyph}"
           FontSize="20"
           VerticalAlignment="Center"
           Margin="0,0,8,0"
           RenderTransformOrigin="0.5,0.5">
                                    <TextBlock.RenderTransform>
                                        <ScaleTransform ScaleX="1" ScaleY="1"/>
                                    </TextBlock.RenderTransform>

                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <!-- Базовый цвет -->
                                            <Setter Property="Foreground" Value="#888"/>

                                            <Style.Triggers>
                                                <!-- Живой: зелёный -->
                                                <DataTrigger Binding="{Binding IsAlive}" Value="True">
                                                    <Setter Property="Foreground" Value="#7CFF7C"/>
                                                </DataTrigger>
                                                <!-- Мёртвый: красный -->
                                                <DataTrigger Binding="{Binding IsAlive}" Value="False">
                                                    <Setter Property="Foreground" Value="#FF4040"/>
                                                </DataTrigger>

                                                <!-- Пульс: короткая анимация при переходе false → true -->
                                                <DataTrigger Binding="{Binding IsPulsing}" Value="True">
                                                    <DataTrigger.EnterActions>
                                                        <BeginStoryboard x:Name="PulseSB">
                                                            <Storyboard>
                                                                <DoubleAnimation
                                    Storyboard.TargetProperty="Opacity"
                                    From="1.0" To="0.35"
                                    Duration="0:0:0.14"
                                    AutoReverse="True"/>
                                                                <DoubleAnimation
                                    Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                                    From="1.0" To="1.7"
                                    Duration="0:0:0.14"
                                    AutoReverse="True"/>
                                                                <DoubleAnimation
                                    Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                                    From="1.0" To="1.7"
                                    Duration="0:0:0.14"
                                    AutoReverse="True"/>
                                                            </Storyboard>
                                                        </BeginStoryboard>
                                                    </DataTrigger.EnterActions>
                                                    <DataTrigger.ExitActions>
                                                        <StopStoryboard BeginStoryboardName="PulseSB"/>
                                                    </DataTrigger.ExitActions>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>

                                <!-- Имя игрока -->
                                <TextBlock Text="{Binding Name}"
                                   FontSize="{Binding DataContext.NameFontSize,
                                              RelativeSource={RelativeSource AncestorType=Window}}"
                                   FontWeight="Bold"
                                   Foreground="{Binding DataContext.TextBrush,
                                                RelativeSource={RelativeSource AncestorType=Window}}"
                                   TextAlignment="Center"
                                   VerticalAlignment="Center"/>
                            </StackPanel>

                            <TextBlock Text="{Binding Score}"
                               FontSize="{Binding DataContext.ScoreFontSize,
                                          RelativeSource={RelativeSource AncestorType=Window}}"
                               FontWeight="Bold"
                               Foreground="{Binding DataContext.AccentBrush,
                                            RelativeSource={RelativeSource AncestorType=Window}}"
                               TextAlignment="Center"
                               Margin="0,6,0,0"/>
                        </StackPanel>
                    </Border>

                    <!-- Анимации — на уровне DataTemplate.Triggers -->
                    <DataTemplate.Triggers>
                        <DataTrigger Binding="{Binding HeartbeatPulse}" Value="1">
                            <DataTrigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="HbDot"
                                                 Storyboard.TargetProperty="Opacity"
                                                 From="1.0" To="0.3"
                                                 Duration="0:0:0.15"
                                                 AutoReverse="True"/>
                                        <DoubleAnimation Storyboard.TargetName="HbDotScale"
                                                 Storyboard.TargetProperty="ScaleX"
                                                 From="1.0" To="1.6"
                                                 Duration="0:0:0.15"
                                                 AutoReverse="True"/>
                                        <DoubleAnimation Storyboard.TargetName="HbDotScale"
                                                 Storyboard.TargetProperty="ScaleY"
                                                 From="1.0" To="1.6"
                                                 Duration="0:0:0.15"
                                                 AutoReverse="True"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </DataTrigger.EnterActions>
                        </DataTrigger>

                        <DataTrigger Binding="{Binding HeartbeatPulse}" Value="0">
                            <DataTrigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="HbDot"
                                                 Storyboard.TargetProperty="Opacity"
                                                 From="1.0" To="0.3"
                                                 Duration="0:0:0.15"
                                                 AutoReverse="True"/>
                                        <DoubleAnimation Storyboard.TargetName="HbDotScale"
                                                 Storyboard.TargetProperty="ScaleX"
                                                 From="1.0" To="1.6"
                                                 Duration="0:0:0.15"
                                                 AutoReverse="True"/>
                                        <DoubleAnimation Storyboard.TargetName="HbDotScale"
                                                 Storyboard.TargetProperty="ScaleY"
                                                 From="1.0" To="1.6"
                                                 Duration="0:0:0.15"
                                                 AutoReverse="True"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </DataTrigger.EnterActions>
                        </DataTrigger>
                    </DataTemplate.Triggers>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </Grid>
</Window>
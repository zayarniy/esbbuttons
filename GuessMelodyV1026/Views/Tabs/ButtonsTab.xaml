<UserControl x:Class="GuessMelody.Views.Tabs.ButtonsTab"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <DockPanel Margin="6">

        <!-- Панель 1: сервер -->
        <Border DockPanel.Dock="Top" Padding="6" Background="#F0F0F0"
                BorderBrush="#CCC" BorderThickness="0,0,0,1">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="UDP порт:" VerticalAlignment="Center" Margin="0,0,4,0"/>
                <TextBox Width="60" Text="{Binding UdpPort, UpdateSourceTrigger=PropertyChanged}"
                         IsEnabled="{Binding IsRunning, Converter={StaticResource BoolInverter}}"
                         VerticalContentAlignment="Center"/>

                <TextBlock Text="IP сервера:" VerticalAlignment="Center" Margin="12,0,4,0"/>
                <TextBox Width="140" Text="{Binding ServerIp, UpdateSourceTrigger=PropertyChanged}"
                         VerticalContentAlignment="Center"/>

                <Button Content="▶ Запустить" Command="{Binding StartCommand}"
                        Margin="16,0,4,0" Padding="10,4"/>
                <Button Content="■ Остановить" Command="{Binding StopCommand}"
                        Margin="4,0,16,0" Padding="10,4"/>

                <TextBlock Text="{Binding AliveSummary}" VerticalAlignment="Center" FontWeight="Bold"
                           Foreground="DarkGreen" Margin="0,0,16,0"/>
                <TextBlock Text="{Binding LocalIpsText}" VerticalAlignment="Center" Foreground="#555"/>
            </StackPanel>
        </Border>

        <!-- Панель 2: действия с командами -->
        <Border DockPanel.Dock="Top" Padding="6" Background="#FAFAFA"
                BorderBrush="#CCC" BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <WrapPanel Grid.Column="0">
                    <Button Content="➕ Добавить" Command="{Binding AddTeamCommand}"
                            Padding="8,3" Margin="0,0,4,0"/>
                    <Button Content="➖ Удалить выбранные" Command="{Binding RemoveTeamCommand}"
                            Padding="8,3" Margin="0,0,4,0"/>
                    <Button Content="🎯 Захватить MAC" Command="{Binding CaptureMacCommand}"
                            Padding="8,3" Margin="0,0,4,0"
                            Background="#FFF3C4"/>
                    <Button Content="✖ Отменить захват" Command="{Binding CancelCaptureCommand}"
                            Padding="8,3" Margin="0,0,12,0"/>
                    <Button Content="✔ Применить имена/MAC" Command="{Binding RenameTeamCommand}"
                            Padding="8,3" Margin="0,0,12,0"
                            Background="#C8E6C9"/>
                    <Button Content="↩ Отвязать MAC" Command="{Binding ClearMacCommand}"
                            Padding="8,3" Margin="0,0,12,0"/>
                    <Button Content="🔓 Разблокировать" Command="{Binding UnblockCommand}"
                            Padding="8,3" Margin="0,0,12,0"/>
                </WrapPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button Content="☑ Все" Command="{Binding SelectAllCommand}" Padding="8,3" Margin="0,0,4,0"/>
                    <Button Content="☐ Никого" Command="{Binding DeselectAllCommand}" Padding="8,3" Margin="0,0,4,0"/>
                    <Button Content="◉ Живых" Command="{Binding SelectAliveCommand}" Padding="8,3"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Панель 3: эмуляция -->
        <Border DockPanel.Dock="Top" Padding="6" Background="#FFF8E1"
                BorderBrush="#E0C97F" BorderThickness="0,0,0,1">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="Эмуляция:" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <Button Content="💓 HB выбранным" Command="{Binding EmulateHbCommand}"
                        Padding="8,3" Margin="0,0,4,0"/>
                <Button Content="🔄 REBOOT выбранным" Command="{Binding RebootSelectedCommand}"
                        Padding="8,3" Margin="0,0,16,0"/>
                <CheckBox Content="Автосоздавать команды при HB неизвестных MAC"
                          IsChecked="{Binding AutoCreateUnknown}"
                          VerticalAlignment="Center" Margin="0,0,16,0"/>
                <TextBlock Text="{Binding CaptureStatusText}" VerticalAlignment="Center"
                           FontWeight="Bold" Foreground="#B8860B"/>
            </StackPanel>
        </Border>

        <!-- Таблица команд -->
        <DataGrid ItemsSource="{Binding Rows}"
                  AutoGenerateColumns="False"
                  CanUserAddRows="False"
                  HeadersVisibility="Column"
                  GridLinesVisibility="Horizontal"
                  AlternatingRowBackground="#FAFAFA">
            <DataGrid.RowStyle>
                <Style TargetType="DataGridRow">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding Alive}" Value="False">
                            <Setter Property="Foreground" Value="#999"/>
                            <Setter Property="Background" Value="#FFF3E0"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </DataGrid.RowStyle>

            <DataGrid.Columns>
                <DataGridCheckBoxColumn Header="✓" Width="30"
                                        Binding="{Binding IsSelected}"/>
                <DataGridTextColumn Header="ID" Binding="{Binding Id, UpdateSourceTrigger=LostFocus}" Width="40" IsReadOnly="True"/>
                <DataGridTextColumn Header="Имя" Binding="{Binding Name, UpdateSourceTrigger=LostFocus}" Width="160"/>
                <DataGridTextColumn Header="MAC" Binding="{Binding Mac, UpdateSourceTrigger=LostFocus}" Width="160"/>
                <DataGridTextColumn Header="IP" Binding="{Binding LastIp}" Width="130" IsReadOnly="True"/>
                <DataGridTextColumn Header="Сост." Binding="{Binding IsAliveText}" Width="70" IsReadOnly="True"/>
                <DataGridTextColumn Header="Нажатий" Binding="{Binding PressCount}" Width="70" IsReadOnly="True"/>
                <DataGridTextColumn Header="Доставка HB" Binding="{Binding DeliveryText}" Width="130" IsReadOnly="True"/>
                <DataGridTextColumn Header="Посл. seq" Binding="{Binding LastSeq}" Width="80" IsReadOnly="True"/>
                <DataGridTextColumn Header="Первый раз" Binding="{Binding FirstSeenLocal}" Width="90" IsReadOnly="True"/>
                <DataGridTextColumn Header="Последний раз" Binding="{Binding LastSeenLocal}" Width="100" IsReadOnly="True"/>
                <DataGridTextColumn Header="Тишина, с" Binding="{Binding SecondsSinceLastSeen}" Width="80" IsReadOnly="True"/>
                <DataGridTemplateColumn Header="" Width="90">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Button Content="🎯 Захват"
                                    Command="{Binding DataContext.CaptureMacCommand,
                                              RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                    CommandParameter="{Binding Id}"
                                    Padding="4,2"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>
    </DockPanel>
</UserControl>
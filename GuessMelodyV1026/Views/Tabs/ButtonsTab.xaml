<UserControl x:Class="GuessMelody.Views.Tabs.ButtonsTab"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <DockPanel Margin="6">

        <!-- Панель 1: сервер -->
        <Border DockPanel.Dock="Top" Padding="6" Background="#F0F0F0"
                BorderBrush="#CCC" BorderThickness="0,0,0,1">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="UDP порт:" VerticalAlignment="Center" Margin="0,0,4,0"/>
                <TextBox Width="60" Text="{Binding UdpPort, UpdateSourceTrigger=PropertyChanged}"
                         IsEnabled="{Binding IsRunning, Converter={StaticResource BoolInverter}}"
                         VerticalContentAlignment="Center"/>

                <TextBlock Text="IP сервера:" VerticalAlignment="Center" Margin="12,0,4,0"/>
                <TextBox Width="140" Text="{Binding ServerIp, UpdateSourceTrigger=PropertyChanged}"
                         VerticalContentAlignment="Center"/>

                <Button Content="▶ Запустить" Command="{Binding StartCommand}"
                        Margin="16,0,4,0" Padding="10,4"/>
                <Button Content="■ Остановить" Command="{Binding StopCommand}"
                        Margin="4,0,16,0" Padding="10,4"/>

                <TextBlock Text="Локальные IP:" VerticalAlignment="Center" Margin="0,0,4,0"/>
                <TextBlock Text="{Binding LocalIpsText}" Foreground="#555" VerticalAlignment="Center"/>
            </StackPanel>
        </Border>

        <!-- Панель 2: команды и привязки -->
        <Border DockPanel.Dock="Top" Padding="6" Background="#FAFAFA"
                BorderBrush="#CCC" BorderThickness="0,0,0,1">
            <StackPanel Orientation="Horizontal">
                <Button Content="⤓ Загрузить привязки" Command="{Binding LoadCommand}" Padding="8,3" Margin="0,0,4,0"/>
                <Button Content="⤒ Сохранить привязки" Command="{Binding SaveCommand}" Padding="8,3" Margin="0,0,16,0"/>

                <Button Content="Отметить все"  Command="{Binding SelectAllCommand}"   Padding="8,3" Margin="0,0,4,0"/>
                <Button Content="Снять все"     Command="{Binding DeselectAllCommand}" Padding="8,3" Margin="0,0,4,0"/>
                <Button Content="Только живые"  Command="{Binding SelectAliveCommand}" Padding="8,3" Margin="0,0,16,0"/>

                <Button Content="SETSRV → выбранным/всем" Command="{Binding SendSetServerCommand}" Padding="8,3" Margin="0,0,4,0"/>
                <Button Content="GETCFG"                  Command="{Binding SendGetCfgCommand}"    Padding="8,3" Margin="0,0,16,0"/>
                <Button Content="Применить имена"         Command="{Binding ApplyNamesCommand}"    Padding="8,3"/>
            </StackPanel>
        </Border>

        <!-- Эмуляция -->
        <Border DockPanel.Dock="Top" Padding="6" Background="#FFF8E1"
                BorderBrush="#E0C97F" BorderThickness="0,0,0,1">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="Эмуляция:" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <ItemsControl ItemsSource="{Binding Rows}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Content="{Binding Name}"
                                    Padding="8,3" Margin="0,0,4,0"
                                    Command="{Binding DataContext.EmulatePressCommand,
                                              RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                    CommandParameter="{Binding Mac}"/>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </Border>

        <!-- Таблица -->
        <DataGrid ItemsSource="{Binding Rows}"
                  AutoGenerateColumns="False"
                  CanUserAddRows="False"
                  HeadersVisibility="Column"
                  GridLinesVisibility="Horizontal"
                  AlternatingRowBackground="#FAFAFA">
            <DataGrid.Columns>
                <DataGridCheckBoxColumn Header="✓" Width="30"
                            Binding="{Binding IsSelected, UpdateSourceTrigger=PropertyChanged}"/>
                <DataGridTextColumn Header="Имя"        Binding="{Binding Name, UpdateSourceTrigger=PropertyChanged}" Width="160"/>
                <DataGridTextColumn Header="MAC"        Binding="{Binding Mac}"             Width="160" IsReadOnly="True"/>
                <DataGridTextColumn Header="IP"         Binding="{Binding LastIp}"          Width="130" IsReadOnly="True"/>
                <DataGridTextColumn Header="Сост."      Binding="{Binding Alive, Converter={StaticResource AliveConverter}}"
                        Width="70" IsReadOnly="True"/>
                <DataGridTextColumn Header="Нажатий"    Binding="{Binding PressCount}"      Width="70"  IsReadOnly="True"/>
                <DataGridTextColumn Header="Доставка HB" Binding="{Binding DeliveryText}"   Width="150" IsReadOnly="True"/>
                <DataGridTextColumn Header="HB, с назад" Binding="{Binding HbSecondsAgo}"   Width="90"  IsReadOnly="True"/>
                <DataGridTextColumn Header="Посл. seq"  Binding="{Binding LastSeq}"         Width="80"  IsReadOnly="True"/>
                <DataGridTextColumn Header="Первый раз" Binding="{Binding FirstSeenLocal}"  Width="90"  IsReadOnly="True"/>
                <DataGridTextColumn Header="Последний раз" Binding="{Binding LastSeenLocal}" Width="100" IsReadOnly="True"/>
                <DataGridTextColumn Header="Тишина, с"  Binding="{Binding SecondsSinceLastSeen}" Width="80" IsReadOnly="True"/>
            </DataGrid.Columns>
        </DataGrid>
    </DockPanel>
</UserControl>
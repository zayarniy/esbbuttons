<UserControl x:Class="GuessMelody.Views.Tabs.LogTab"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <DockPanel Margin="6">

        <!-- Верхняя панель: экспорт и автопрокрутка -->
        <Border DockPanel.Dock="Top" Padding="6" Background="#F0F0F0"
                BorderBrush="#CCC" BorderThickness="0,0,0,1">
            <StackPanel Orientation="Horizontal">
                <Button Content="⤓ Сохранить CSV" Command="{Binding SaveCsvCommand}"
                        Padding="10,4" Margin="0,0,4,0"/>
                <Button Content="⤓ Сохранить TXT" Command="{Binding SaveTxtCommand}"
                        Padding="10,4" Margin="0,0,16,0"/>
                <Button Content="Очистить журнал" Command="{Binding ClearCommand}"
                        Padding="10,4" Margin="0,0,16,0"/>
                <CheckBox Content="Прокручивать до конца"
                          IsChecked="{Binding AutoScroll}"
                          VerticalAlignment="Center" Margin="0,0,16,0"/>
                <TextBlock Text="Поиск:" VerticalAlignment="Center" Margin="0,0,4,0"/>
                <TextBox Width="240" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                         VerticalContentAlignment="Center"/>
            </StackPanel>
        </Border>

        <!-- Фильтры -->
        <Border DockPanel.Dock="Top" Padding="6" Background="#FAFAFA"
                BorderBrush="#CCC" BorderThickness="0,0,0,1">
            <WrapPanel>
                <TextBlock Text="Показывать:" FontWeight="Bold"
                           VerticalAlignment="Center" Margin="0,0,8,0"/>
                <CheckBox Content="Raw"        IsChecked="{Binding FilterRaw}"        Margin="0,0,8,0"/>
                <CheckBox Content="Connect"    IsChecked="{Binding FilterConnect}"    Margin="0,0,8,0"/>
                <CheckBox Content="Reconnect"  IsChecked="{Binding FilterReconnect}"  Margin="0,0,8,0"/>
                <CheckBox Content="Disconnect" IsChecked="{Binding FilterDisconnect}" Margin="0,0,8,0"/>
                <CheckBox Content="Press"      IsChecked="{Binding FilterPress}"      Margin="0,0,8,0"/>
                <CheckBox Content="Hb"         IsChecked="{Binding FilterHb}"         Margin="0,0,8,0"/>
                <CheckBox Content="System"     IsChecked="{Binding FilterSystem}"     Margin="0,0,8,0"/>
                <CheckBox Content="Error"      IsChecked="{Binding FilterError}"      Margin="0,0,8,0"/>
                <CheckBox Content="Game"       IsChecked="{Binding FilterGame}"       Margin="0,0,8,0"/>
                <CheckBox Content="Audio"      IsChecked="{Binding FilterAudio}"      Margin="0,0,8,0"/>
                <CheckBox Content="Score"      IsChecked="{Binding FilterScore}"      Margin="0,0,8,0"/>
                <CheckBox Content="Http"       IsChecked="{Binding FilterHttp}"       Margin="0,0,0,0"/>
            </WrapPanel>
        </Border>

        <!-- Список записей -->
        <ListBox ItemsSource="{Binding View}"
                 x:Name="LogList"
                 VirtualizingPanel.IsVirtualizing="True"
                 VirtualizingPanel.VirtualizationMode="Recycling"
                 ScrollViewer.HorizontalScrollBarVisibility="Auto">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource LogText}"
                                   Text="{Binding TimeText}"
                                   Foreground="#888" Width="90"/>
                        <TextBlock Style="{StaticResource LogText}"
                                   Text="{Binding KindText}"
                                   Width="90"
                                   Foreground="{Binding Kind, Converter={StaticResource LogKindToBrush}}"/>
                        <TextBlock Style="{StaticResource LogText}"
                                   Text="{Binding Message}"/>
                    </StackPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </DockPanel>
</UserControl>
<UserControl x:Class="GuessMelody.Views.Tabs.GameTab"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="12">

            <!-- Заголовок + имя игры -->
            <Grid Margin="0,0,0,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="Игра" FontSize="18" FontWeight="Bold"/>
                    <TextBlock Text="{Binding CurrentGameInfo}" Foreground="#666" Margin="0,4,0,0"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="Имя игры:" VerticalAlignment="Center" Margin="0,0,4,0"/>
                    <TextBox Width="240" Text="{Binding GameName, UpdateSourceTrigger=PropertyChanged}"
                             VerticalContentAlignment="Center"/>
                </StackPanel>
            </Grid>

            <!-- Сервер -->
            <GroupBox Header="Сервер кнопок" Padding="8" Margin="0,0,0,10">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                        <TextBlock Text="UDP порт:" VerticalAlignment="Center" Width="100"/>
                        <TextBox Width="80" Text="{Binding UdpPort, UpdateSourceTrigger=PropertyChanged}"
                                 IsEnabled="{Binding IsRunning, Converter={StaticResource BoolInverter}}"
                                 VerticalContentAlignment="Center"/>

                        <TextBlock Text="IP сервера:" VerticalAlignment="Center" Width="100" Margin="20,0,0,0"/>
                        <TextBox Width="140" Text="{Binding ServerIp, UpdateSourceTrigger=PropertyChanged}"
                                 VerticalContentAlignment="Center"/>

                        <TextBlock Text="Локальные IP:" VerticalAlignment="Center" Margin="20,0,4,0"/>
                        <TextBlock Text="{Binding LocalIpsText}" Foreground="#555" VerticalAlignment="Center"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <Button Content="▶ Запустить сервер"  Command="{Binding StartCommand}" Padding="10,4" Margin="0,0,4,0"/>
                        <Button Content="■ Остановить сервер" Command="{Binding StopCommand}"  Padding="10,4" Margin="0,0,16,0"/>
                        <TextBlock Text="{Binding StatusText}" VerticalAlignment="Center" Foreground="#555"/>
                    </StackPanel>
                </StackPanel>
            </GroupBox>

            <!-- Файл игры -->
            <GroupBox Header="Файл игры" Padding="8" Margin="0,0,0,10">
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <Button Content="🆕 Новая игра"      Command="{Binding NewGameCommand}"     Padding="10,4" Margin="0,0,8,0"/>
                        <Button Content="⤓ Загрузить игру"   Command="{Binding LoadGameCommand}"    Padding="10,4" Margin="0,0,8,0"/>
                        <Button Content="⤒ Сохранить игру"   Command="{Binding SaveGameCommand}"    Padding="10,4" Margin="0,0,8,0"/>
                        <Button Content="Сохранить как…"      Command="{Binding SaveGameAsCommand}"  Padding="10,4"/>
                    </StackPanel>

                    <TextBlock Text="Недавние:" FontWeight="Bold" Margin="0,12,0,4"/>
                    <ItemsControl ItemsSource="{Binding RecentFiles}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Content="{Binding}"
                                        HorizontalContentAlignment="Left"
                                        Padding="4,2" Margin="0,1"
                                        Command="{Binding DataContext.OpenRecentCommand,
                                                  RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                        CommandParameter="{Binding}"/>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </GroupBox>

            <!-- Состояние -->
            <GroupBox Header="Текущее состояние" Padding="8" Margin="0,0,0,10">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                        <TextBlock Text="{Binding RoundText}" FontSize="18" FontWeight="Bold"
                                   Margin="0,0,20,0" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding StateText}" FontSize="16"
                                   Margin="0,0,20,0" VerticalAlignment="Center" Foreground="#555"/>
                        <TextBlock Text="{Binding FirstPressedText, StringFormat='Первый: {0}'}"
                                   FontSize="16" VerticalAlignment="Center" Foreground="#B00"/>
                    </StackPanel>
                    <TextBlock>
                        <Run Text="Категория: "/>
                        <Run Text="{Binding CategoryText, Mode=OneWay}" FontWeight="Bold"/>
                    </TextBlock>
                    <TextBlock Margin="0,4,0,0">
                        <Run Text="Трек: "/>
                        <Run Text="{Binding TrackText, Mode=OneWay}" Foreground="#555"/>
                    </TextBlock>
                    <TextBlock Margin="0,8,0,0" FontWeight="Bold" Text="{Binding TeamsSummaryText}"/>
                </StackPanel>
            </GroupBox>

            <!-- Игровые окна -->
            <GroupBox Header="Игровые окна" Padding="8" Margin="0,0,0,10">
                <StackPanel Orientation="Horizontal">
                    <Button Content="Открыть экран игроков" Command="{Binding OpenPlayerCommand}"
                            Padding="10,4" Margin="0,0,4,0"/>
                    <Button Content="Открыть окно ведущего" Command="{Binding OpenHostCommand}"
                            Padding="10,4"/>
                </StackPanel>
            </GroupBox>

            <!-- Быстрый старт -->
            <GroupBox Header="Быстрый старт (отладка без реальных кнопок)" Padding="8" Margin="0,0,0,10">
                <StackPanel>
                    <TextBlock TextWrapping="Wrap" Foreground="#666" Margin="0,0,0,8"
                               Text="«Заполнить демо» создаёт 3 игрока (VIRT:01..03) и 3 категории по 3 трека. «Быстрый тест» сразу стартует 1-й раунд. Клавиши 1/2/3 — эмуляция нажатия игрока, Q — начислить очко, A — не начислять, Space — старт раунда, Esc — Panic."/>
                    <StackPanel Orientation="Horizontal">
                        <Button Content="🎬 Заполнить демо" Command="{Binding FillDemoCommand}"
                                Padding="12,6" Margin="0,0,8,0"/>
                        <Button Content="⚡ Быстрый тест"   Command="{Binding QuickDemoCommand}"
                                Padding="12,6" Margin="0,0,8,0"
                                Background="#C8E6C9"/>
                        <Button Content="🔄 Сбросить очки"  Command="{Binding ResetScoresCommand}"
                                Padding="12,6" Margin="0,0,8,0"/>
                        <Button Content="⏹ Сброс раунда"    Command="{Binding ResetRoundCommand}"
                                Padding="12,6" Margin="0,0,8,0"/>
                        <Button Content="🚨 Panic"          Command="{Binding PanicCommand}"
                                Padding="12,6" Background="#FFCDD2"/>
                    </StackPanel>
                </StackPanel>
            </GroupBox>

            <!-- Управление раундом -->
            <GroupBox Header="Управление раундом" Padding="8" Margin="0,0,0,10">
                <StackPanel>
                    <TextBlock Text="Старт раунда (категория 1..9):" FontWeight="Bold" Margin="0,0,0,6"/>
                    <WrapPanel>
                        <Button Content="1" Command="{Binding TestRoundCommand}" CommandParameter="1"
                                Width="42" Height="32" Margin="0,0,4,4"/>
                        <Button Content="2" Command="{Binding TestRoundCommand}" CommandParameter="2"
                                Width="42" Height="32" Margin="0,0,4,4"/>
                        <Button Content="3" Command="{Binding TestRoundCommand}" CommandParameter="3"
                                Width="42" Height="32" Margin="0,0,4,4"/>
                        <Button Content="4" Command="{Binding TestRoundCommand}" CommandParameter="4"
                                Width="42" Height="32" Margin="0,0,4,4"/>
                        <Button Content="5" Command="{Binding TestRoundCommand}" CommandParameter="5"
                                Width="42" Height="32" Margin="0,0,4,4"/>
                        <Button Content="6" Command="{Binding TestRoundCommand}" CommandParameter="6"
                                Width="42" Height="32" Margin="0,0,4,4"/>
                        <Button Content="7" Command="{Binding TestRoundCommand}" CommandParameter="7"
                                Width="42" Height="32" Margin="0,0,4,4"/>
                        <Button Content="8" Command="{Binding TestRoundCommand}" CommandParameter="8"
                                Width="42" Height="32" Margin="0,0,4,4"/>
                        <Button Content="9" Command="{Binding TestRoundCommand}" CommandParameter="9"
                                Width="42" Height="32" Margin="0,0,4,4"/>
                    </WrapPanel>
                </StackPanel>
            </GroupBox>

            <!-- Нажатия игроков -->
            <GroupBox Header="Эмуляция нажатий (игрок 1..6)" Padding="8" Margin="0,0,0,10">
                <StackPanel Orientation="Horizontal">
                    <Button Content="1" Command="{Binding TestPressCommand}" CommandParameter="1"
                            Width="52" Height="40" FontSize="18" Margin="0,0,6,0"/>
                    <Button Content="2" Command="{Binding TestPressCommand}" CommandParameter="2"
                            Width="52" Height="40" FontSize="18" Margin="0,0,6,0"/>
                    <Button Content="3" Command="{Binding TestPressCommand}" CommandParameter="3"
                            Width="52" Height="40" FontSize="18" Margin="0,0,6,0"/>
                    <Button Content="4" Command="{Binding TestPressCommand}" CommandParameter="4"
                            Width="52" Height="40" FontSize="18" Margin="0,0,6,0"/>
                    <Button Content="5" Command="{Binding TestPressCommand}" CommandParameter="5"
                            Width="52" Height="40" FontSize="18" Margin="0,0,6,0"/>
                    <Button Content="6" Command="{Binding TestPressCommand}" CommandParameter="6"
                            Width="52" Height="40" FontSize="18"/>
                </StackPanel>
            </GroupBox>
            <!-- Heartbeat игроков -->
            <GroupBox Header="Эмуляция heartbeat (один удар, игрок 1..6)" Padding="8" Margin="0,0,0,10">
                <StackPanel>
                    <TextBlock TextWrapping="Wrap" Foreground="#666" Margin="0,0,0,6"
                   Text="Отправляет один heartbeat от имени игрока. Значок рядом с именем игрока в окнах Player/Host пульсирует и становится зелёным. Полезно для проверки индикации, когда нет физической кнопки."/>
                    <StackPanel Orientation="Horizontal">
                        <Button Content="HB 1" Command="{Binding TestHeartbeatCommand}" CommandParameter="1"
                    Width="60" Height="32" FontSize="14" Margin="0,0,6,0"/>
                        <Button Content="HB 2" Command="{Binding TestHeartbeatCommand}" CommandParameter="2"
                    Width="60" Height="32" FontSize="14" Margin="0,0,6,0"/>
                        <Button Content="HB 3" Command="{Binding TestHeartbeatCommand}" CommandParameter="3"
                    Width="60" Height="32" FontSize="14" Margin="0,0,6,0"/>
                        <Button Content="HB 4" Command="{Binding TestHeartbeatCommand}" CommandParameter="4"
                    Width="60" Height="32" FontSize="14" Margin="0,0,6,0"/>
                        <Button Content="HB 5" Command="{Binding TestHeartbeatCommand}" CommandParameter="5"
                    Width="60" Height="32" FontSize="14" Margin="0,0,6,0"/>
                        <Button Content="HB 6" Command="{Binding TestHeartbeatCommand}" CommandParameter="6"
                    Width="60" Height="32" FontSize="14"/>
                    </StackPanel>
                </StackPanel>
            </GroupBox>
            <!-- Очки -->
            <GroupBox Header="Оценка ответа" Padding="8" Margin="0,0,0,0">
                <StackPanel Orientation="Horizontal">
                    <Button Content="✅ Да (Q)"  Command="{Binding TestScoreYesCommand}"
                            Padding="14,6" FontSize="16" Margin="0,0,8,0" Background="#C8E6C9"/>
                    <Button Content="❌ Нет (A)" Command="{Binding TestScoreNoCommand}"
                            Padding="14,6" FontSize="16" Margin="0,0,16,0" Background="#FFCDD2"/>
                    <Button Content="⏭ Следующий раунд" Command="{Binding NextRoundCommand}"
                            Padding="14,6" FontSize="16"/>
                </StackPanel>
            </GroupBox>

        </StackPanel>
    </ScrollViewer>
</UserControl>
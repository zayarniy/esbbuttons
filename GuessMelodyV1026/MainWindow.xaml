<Window x:Class="GuessMelody.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:tabs="clr-namespace:GuessMelody.Views.Tabs"
        xmlns:local="clr-namespace:GuessMelody"
        mc:Ignorable="d"
 Title="Угадай мелодию" Height="820" Width="1400"
        WindowStartupLocation="CenterScreen">

    <DockPanel>
        <StatusBar DockPanel.Dock="Bottom">
            <StatusBarItem>
                <TextBlock Text="{Binding StatusText}"/>
            </StatusBarItem>
            <StatusBarItem HorizontalAlignment="Right">
                <TextBlock Text="{Binding Buttons.AliveSummary}" Margin="0,0,12,0"/>
            </StatusBarItem>
        </StatusBar>

        <TabControl Margin="4">
            <TabItem Header="Игра">
                <tabs:GameTab DataContext="{Binding Game}"/>
            </TabItem>
            <TabItem Header="Настройки">
                <tabs:SettingsTab DataContext="{Binding Settings}"/>
            </TabItem>
            <TabItem Header="Кнопки">
                <tabs:ButtonsTab DataContext="{Binding Buttons}"/>
            </TabItem>
            <TabItem Header="Папки">
                <tabs:FoldersTab DataContext="{Binding Folders}"/>
            </TabItem>
            <TabItem Header="Журнал">
                <tabs:LogTab DataContext="{Binding Log}"/>
            </TabItem>
            <TabItem Header="Сервер ответов">
                <tabs:AnswerServerTab DataContext="{Binding AnswerServer}"/>
            </TabItem>
        </TabControl>
    </DockPanel>
</Window>

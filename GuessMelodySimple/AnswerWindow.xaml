<Window x:Class="GuessMelodySimple.AnswerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:GuessMelodySimple"
        mc:Ignorable="d"
       Title="Правильный ответ"
        WindowStyle="None"
        WindowState="Maximized"
        Background="Black"
        Topmost="True"
        KeyDown="Window_KeyDown"
        MouseDown="Window_MouseDown">
    <Grid>
        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
            <TextBlock Text="ПРАВИЛЬНЫЙ ОТВЕТ"
                       Foreground="#FFCC00"
                       FontSize="48"
                       FontWeight="Bold"
                       HorizontalAlignment="Center"
                       Margin="0,0,0,40"/>

            <TextBlock x:Name="TxtAnswer"
                       Foreground="White"
                       FontSize="96"
                       FontWeight="Bold"
                       TextAlignment="Center"
                       TextWrapping="Wrap"
                       MaxWidth="1400"/>

            <TextBlock Text="(нажмите любую клавишу или щёлкните мышью, чтобы закрыть)"
                       Foreground="#666"
                       FontSize="18"
                       HorizontalAlignment="Center"
                       Margin="0,80,0,0"/>
        </StackPanel>
    </Grid>
</Window>
